<?xml version="1.0"?>
<!-- FR3 arm with the visual meshes, for scenes that show one robot up close; no hand. -->
<robot name="fr3_visual">

  <link name="link0">
    <visual name="link0_visual">
      <geometry>
        <mesh filename="package://franka_description/meshes/robots/fr3/visual/link0.glb"/>
      </geometry>
    </visual>
  </link>

  <link name="link1">
    <visual name="link1_visual">
      <geometry>
        <mesh filename="package://franka_description/meshes/robots/fr3/visual/link1.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <parent link="link0"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9007" upper="2.9007" effort="87.0" velocity="2.62"/>
  </joint>

